<section class="tisso-gallery page-width">

  {% if section.settings.heading != blank %}
    <h2 class="tisso-gallery-heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="tisso-gallery-grid">

    {% for block in section.blocks %}

      <div class="gallery-item" {{ block.shopify_attributes }}>

        {% if block.settings.image != blank %}

          <img
            src="{{ block.settings.image | image_url: width: 900 }}"
            alt="{{ block.settings.product.title }}"
            class="gallery-image"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
          >

        {% else %}

          {{ 'image' | placeholder_svg_tag: 'gallery-placeholder' }}

        {% endif %}


        {% if block.settings.product != blank %}

          <button
            class="gallery-plus quick-view-btn"
            data-handle="{{ block.settings.product.handle }}"
            type="button"
          >

            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
            >

              <path
                d="M9 3V15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

              <path
                d="M3 9H15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

            </svg>

          </button>

        {% endif %}

      </div>

    {% endfor %}

  </div>

</section>


<script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
<style>

.tisso-gallery{
  padding:60px 0;
}

.tisso-gallery-heading{
  font-size:52px;
  font-weight:400;
  line-height:1.1;
  margin:0 0 35px;
}

.tisso-gallery-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:20px;

}

.gallery-item{

  position:relative;

  overflow:hidden;

}

.gallery-image{

  width:100%;

  display:block;

  aspect-ratio:1/1;

  object-fit:cover;

  transition:transform .4s ease;

}

.gallery-item:hover .gallery-image{

  transform:scale(1.05);

}


/* PLUS ICON */

.gallery-plus{

  position:absolute;

  top:50%;

  left:50%;

  transform:translate(-50%,-50%);

  width:42px;

  height:42px;

  border-radius:50%;

  border:none;

  background:#fff;

  color:#000;

  cursor:pointer;

  display:flex;

  align-items:center;

  justify-content:center;

  box-shadow:

  0 4px 20px rgba(0,0,0,.15);

  transition:.3s;

  z-index:2;

}

.gallery-plus:hover{

  transform:

  translate(-50%,-50%)

  scale(1.1);

}


/* PLACEHOLDER */

.gallery-placeholder{

  width:100%;

  aspect-ratio:1/1;

  background:#f5f5f5;

}

.gallery-placeholder svg{

  width:100%;

  height:100%;

}


/* QUICK VIEW */

#qv-modal{

  position:fixed;

  inset:0;

  z-index:999;

  display:none;

}

#qv-modal.active{

  display:block;

}

.qv-overlay{

  position:absolute;

  inset:0;

  background:

  rgba(0,0,0,.5);

}

.qv-box{

  position:absolute;

  top:50%;

  left:50%;

  transform:

  translate(-50%,-50%);

  width:900px;

  max-width:95%;

  background:#fff;

  display:flex;

  gap:40px;

  padding:30px;

}

.qv-left{

  width:50%;

}

.qv-left img{

  width:100%;

  display:block;

}

.qv-right{

  width:50%;

}

.qv-close{

  position:absolute;

  top:15px;

  right:20px;

  border:none;

  background:none;

  font-size:30px;

  cursor:pointer;

}

#qv-title{

  font-size:32px;

  margin:0 0 15px;

}

#qv-price{

  font-size:28px;

  font-weight:700;

  margin-bottom:20px;

}

#qv-description{

  font-size:15px;

  line-height:1.7;

  margin-bottom:25px;

}

.qv-option{

  margin-bottom:20px;

}

.qv-option label{

  display:block;

  margin-bottom:10px;

}

#qv-colors{

  display:flex;

  gap:10px;

  flex-wrap:wrap;

}

.qv-color{

  border:1px solid #ddd;

  background:#fff;

  min-width:90px;

  height:40px;

  cursor:pointer;

}

.qv-color.active{

  background:#000;

  color:#fff;

}

#qv-size{

  width:100%;

  height:42px;

  padding:0 10px;

}

#qv-add{

  width:100%;

  height:50px;

  background:#000;

  color:#fff;

  border:none;

  cursor:pointer;

  font-size:15px;

}


/* MOBILE */

@media(max-width:767px){

.tisso-gallery-grid{

grid-template-columns:

repeat(2,1fr);

gap:10px;

}

.tisso-gallery-heading{

font-size:32px;

}

.qv-box{

flex-direction:column;

padding:20px;

gap:20px;

}

.qv-left,

.qv-right{

width:100%;

}

#qv-title{

font-size:24px;

}

}

</style>
{% schema %}
{
  "name": "Tisso Gallery",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }

  ],

  "blocks": [

    {

      "type": "gallery",

      "name": "Gallery Item",

      "settings": [

        {

          "type": "image_picker",

          "id": "image",

          "label": "Image"

        },

        {

          "type": "product",

          "id": "product",

          "label": "Select Product"

        }

      ]

    }

  ],

  "presets": [

    {

      "name": "Tisso Gallery",

      "blocks": [

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        }

      ]

    }

  ]

}
{% endschema %}
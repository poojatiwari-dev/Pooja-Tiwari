  {{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}
<section class="tisso-gallery page-width">

  {% if section.settings.heading != blank %}
    <h2 class="tisso-gallery-heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  <div class="tisso-gallery-grid">

    {% for block in section.blocks %}

      <div class="gallery-item" {{ block.shopify_attributes }}>

        {% if block.settings.image != blank %}

          <img
            src="{{ block.settings.image | image_url: width: 900 }}"
            alt="{{ block.settings.product.title }}"
            class="gallery-image"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
          >

        {% else %}

          {{ 'image' | placeholder_svg_tag: 'gallery-placeholder' }}

        {% endif %}


        {% if block.settings.product != blank %}

          <button
            class="gallery-plus quick-view-btn"
            data-handle="{{ block.settings.product.handle }}"
            type="button"
          >

            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
            >

              <path
                d="M9 3V15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

              <path
                d="M3 9H15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

            </svg>

          </button>

        {% endif %}

      </div>

    {% endfor %}

  </div>

</section>


<script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Tisso Gallery",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    }

  ],

  "blocks": [

    {

      "type": "gallery",

      "name": "Gallery Item",

      "settings": [

        {

          "type": "image_picker",

          "id": "image",

          "label": "Image"

        },

        {

          "type": "product",

          "id": "product",

          "label": "Select Product"

        }

      ]

    }

  ],

  "presets": [

    {

      "name": "Tisso Gallery",

      "blocks": [

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        },

        {

          "type": "gallery"

        }

      ]

    }

  ]

}
{% endschema %}
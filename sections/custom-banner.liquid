  {{ 'custom-banner.css' | asset_url | stylesheet_tag }}

   <!-- Top Bar -->
  <div class="gift-guide-top">
    <div class="gift-guide-brand">
      {{ section.settings.brand_text }}
    </div>
    <div class="gift-guide-top-text">

      {{ section.settings.top_text }}

    </div>

    {% if section.settings.top_btn_text != blank %}

      <a
        href="{{ section.settings.top_btn_link }}"
        class="gift-guide-btn top-btn"
      >

        <span>

          {{ section.settings.top_btn_text }}

        </span>

        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
        >

          <path
            d="M4 10H16"
            stroke="currentColor"
            stroke-width="1.5"
          />

          <path
            d="M11 5L16 10L11 15"
            stroke="currentColor"
            stroke-width="1.5"
          />

        </svg>

      </a>

    {% endif %}

  </div>



<section class="gift-guide-banner">
    <!-- Content -->

<div class="gift-guide-content">

  {% if section.settings.heading != blank %}
    <h2 class="gift-guide-heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  {% if section.settings.description != blank %}
  <div class="gift-guide-description">
  <span class="desktop-desc">{{ section.settings.description }}</span>
  <span class="mobile-desc">{{ section.settings.mobile_description }}</span>
</div>
  {% endif %}

  {% if section.settings.button_text != blank %}
    <a
      href="{{ section.settings.button_link }}"
      class="gift-guide-btn main-btn"
    >
      <span>{{ section.settings.button_text }}</span>

      <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
        <path d="M4 10H16" stroke="currentColor" stroke-width="1.5"/>
        <path d="M11 5L16 10L11 15" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </a>
  {% endif %}

</div>

<div class="gift-guide-bg">

  {% if section.settings.bg_image != blank %}

    <picture>

      {% if section.settings.mobile_bg_image != blank %}
        <source
          media="(max-width:767px)"
          srcset="{{ section.settings.mobile_bg_image | image_url: width: 900 }}">
            {% else %}
    <img
      src="{{ 'placeholder-banner.png' | asset_url }}"
      alt="Placeholder"
      class="gift-guide-image"
       width="{{ section.settings.mobile_bg_image.width }}"
      height="{{ section.settings.mobile_bg_image.height }}"
    >
      {% endif %}
 <img
      src="{{ section.settings.bg_image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading }}"
      class="gift-guide-image"
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
    >
  {% else %}
    <img
      src="{{ 'placeholder-banner.png' | asset_url }}"
      alt="Placeholder"
      class="gift-guide-image"
       width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
    >

    </picture>

  {% endif %}



</div>
  <!-- Bottom Strip -->

  {% if section.settings.bottom_text != blank %}

    <div class="gift-guide-bottom">

      {{ section.settings.bottom_text }}

    </div>

  {% endif %}

</section>



{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "gift-guide-section",
  "settings": [

    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
    "type": "image_picker",
    "id": "mobile_bg_image",
    "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Top Left Text",
      "default": "TISSO VISION"
    },

    {
      "type": "text",
      "id": "top_text",
      "label": "Top Center Text",
      "default": "Find the ideal gift for your loved ones."
    },

    {
      "type": "text",
      "id": "top_btn_text",
      "label": "Top Right Button Text",
      "default": "CHOOSE GIFT"
    },

    {
      "type": "url",
      "id": "top_btn_link",
      "label": "Top Right Button Link"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore Our Curated Selection and Find the Perfect Presents to Delight Your Loved Ones This Season.</p>"
    },
    {
      "type": "text",
      "id": "mobile_description",
      "label": "Mobile Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Shop Button Link"
    },

    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }

  ],

  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}